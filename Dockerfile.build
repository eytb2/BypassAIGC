FROM python:3.11-slim

WORKDIR /build

# 安装系统依赖
RUN sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 安装打包依赖
COPY package/requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    -r /build/requirements.txt \
    pyinstaller==6.3.0 \
    platformdirs

# 复制工程
COPY package /build/package

WORKDIR /build/package

# 执行 PyInstaller 打包
CMD ["pyinstaller", "app.spec", "--clean"]
